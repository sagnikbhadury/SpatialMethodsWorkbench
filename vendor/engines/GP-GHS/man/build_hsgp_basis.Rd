% Generated by hand to match roxygen comments in R/hsgp-basis.R.
\name{build_hsgp_basis}
\alias{build_hsgp_basis}
\title{Build a 2D Hilbert Space Gaussian Process (HSGP) basis}
\usage{
build_hsgp_basis(coords, m = 5, nu = 1.5, rho = NULL, alpha = 1, L_factor = 1.5)
}
\arguments{
\item{coords}{n x 2 matrix of spatial coordinates.}

\item{m}{Number of basis functions per dimension (\code{m^2} total in 2D).}

\item{nu}{Matern smoothness parameter.}

\item{rho}{Length-scale; if \code{NULL} (default), set to the median
pairwise distance on the normalized coordinates.}

\item{alpha}{GP marginal standard deviation.}

\item{L_factor}{Domain boundary expansion factor.}
}
\value{
A list with \code{phi} (n x m^2 basis matrix), \code{S_diag}
(length-m^2 spectral densities), \code{omega_sq} (length-m^2 squared
eigenfrequencies), \code{m}, \code{m2}, \code{rho}, and \code{nu}.
}
\description{
Constructs the Laplacian eigenfunction basis and associated spectral
densities used to approximate a 2D Matern Gaussian process, following
Riutort-Mayol et al. (2020). Spatial coordinates are first normalized to
\eqn{[-1, 1]}; the basis is a tensor product of 1D sine eigenfunctions of
the Dirichlet Laplacian on \eqn{[-L, L]}.
}
\note{
The original script referenced an undefined \code{lam_y} when combining
per-axis eigenvalues (\code{lam_x[i] + lam_y[j]}); since the 1D eigenvalue
formula depends only on the mode index and domain width (not the
coordinate axis), this has been fixed by setting \code{lam_y <- lam_x}.
}
