% Generated by hand to match roxygen comments in R/graph.R.
\name{gp_group_horseshoe_graph}
\alias{gp_group_horseshoe_graph}
\alias{summarize_node}
\title{Estimate spatially varying cell-cell interaction networks}
\usage{
gp_group_horseshoe_graph(Y, coords, m = 5, nu = 1.5, rho = NULL,
                          nmc = 3000, burn = 1000, thin = 5,
                          edge_threshold = 0.1, symmetry = "AND",
                          n_cores = NULL)

summarize_node(fit, phi, S_diag, q, m2, nbr_names, edge_threshold = 0.1)
}
\arguments{
\item{Y}{n x p normalized expression matrix (spots/cells x cell types).}

\item{coords}{n x 2 spatial coordinate matrix.}

\item{m}{HSGP basis functions per dimension.}

\item{nu}{Matern smoothness (0.5, 1.5, 2.5).}

\item{rho}{GP length-scale (\code{NULL} = auto from median pairwise distance).}

\item{nmc, burn, thin}{MCMC settings for \code{\link{gp_group_horseshoe_sampler}}.}

\item{edge_threshold}{Kappa cutoff for edge detection (informational; edge
activity is thresholded at \code{kappa_mean < 0.5}).}

\item{symmetry}{\code{"AND"} (conservative) or \code{"OR"} (liberal).}

\item{n_cores}{Number of parallel workers (default:
\code{parallel::detectCores() - 1}). Set to 1 to run sequentially.}

\item{fit}{Output of \code{\link{gp_group_horseshoe_sampler}}.}

\item{phi}{n x m2 basis matrix.}

\item{S_diag}{m2 spectral densities.}

\item{q}{Number of neighbors.}

\item{m2}{Basis dimension.}

\item{nbr_names}{Character vector of neighbor names.}
}
\value{
\code{gp_group_horseshoe_graph} returns a list with \code{adj}
(symmetrized adjacency matrix), \code{adj_raw} (directed adjacency before
symmetrization), \code{kappa} (group-level shrinkage matrix),
\code{edge_maps}, \code{edge_summaries}, \code{phi}, \code{S_diag},
\code{coords}, and \code{hsgp_params}.

\code{summarize_node} returns a list with \code{edge_maps},
\code{edge_maps_sd}, \code{kappa_mean}, \code{kappa_sd}, and
\code{edge_summary}.
}
\description{
\code{gp_group_horseshoe_graph} is the main entry point: for each cell
type (column of \code{Y}), regresses its expression on every other cell
type via \code{\link{gp_group_horseshoe_sampler}} using an HSGP spectral
basis built once and shared across all nodewise regressions, recovers
spatial edge maps, and assembles a (optionally symmetrized) cell-cell
interaction adjacency matrix.

\code{summarize_node} summarizes a single-node
\code{gp_group_horseshoe_sampler} fit into spatial edge-strength maps and
group-level shrinkage diagnostics (\eqn{\kappa_j = 1/(1+\lambda_j)}; near
1 = fully shrunk, near 0 = active edge).
}
\examples{
\dontrun{
set.seed(42)
n <- 600; p <- 12
coords <- matrix(runif(n * 2, 0, 10), n, 2)
Y <- matrix(rnorm(n * p), n, p)
colnames(Y) <- paste0("CT", 1:p)

result <- gp_group_horseshoe_graph(Y, coords, m = 4, nu = 1.5,
                                    nmc = 3000, burn = 1000, thin = 5)
print(result$adj)
plot_adj_heatmap(result)
}
}
