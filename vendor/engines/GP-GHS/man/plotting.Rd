% Generated by hand to match roxygen comments in R/plotting.R.
\name{plot_edge_map}
\alias{plot_edge_map}
\alias{plot_all_edges}
\alias{plot_adj_heatmap}
\alias{plot_spectral_density}
\title{Visualization helpers for a gp_group_horseshoe_graph result}
\usage{
plot_edge_map(result, node_s, node_t, plot_sd = FALSE)

plot_all_edges(result, node_s)

plot_adj_heatmap(result)

plot_spectral_density(result)
}
\arguments{
\item{result}{Output of \code{\link{gp_group_horseshoe_graph}}.}

\item{node_s}{Source cell type name.}

\item{node_t}{Target (neighbor) cell type name.}

\item{plot_sd}{Currently unused; reserved for plotting posterior SD instead
of the posterior mean.}
}
\value{
\code{plot_edge_map} returns a \pkg{ggplot2} object if available,
otherwise draws a base R plot and returns \code{NULL} invisibly.

\code{plot_all_edges} and \code{plot_adj_heatmap} return \pkg{ggplot2}
objects (requiring \pkg{ggplot2}, \pkg{tidyr} / \pkg{reshape2}).

\code{plot_spectral_density} returns a \pkg{ggplot2} object if available,
otherwise \code{NULL}.
}
\description{
\code{plot_edge_map} plots the spatially varying edge-strength map for one
directed edge.

\code{plot_all_edges} plots all edge maps for one node as a facetted panel.

\code{plot_adj_heatmap} plots the global adjacency heatmap with shrinkage
signal.

\code{plot_spectral_density} plots the HSGP spectral density diagnostic.
}
