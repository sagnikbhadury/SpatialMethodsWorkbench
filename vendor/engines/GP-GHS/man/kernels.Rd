% Generated by hand to match roxygen comments in R/kernels.R.
\name{matern32_kernel}
\alias{matern32_kernel}
\alias{matern_spectral_density}
\title{Matern kernel and spectral density}
\usage{
matern32_kernel(D, rho, alpha = 1)

matern_spectral_density(omega_sq, nu, rho, alpha = 1)
}
\arguments{
\item{D}{A distance matrix or vector (e.g. from \code{\link[stats]{dist}}).}

\item{rho}{Length-scale.}

\item{alpha}{Marginal standard deviation.}

\item{omega_sq}{Squared eigenfrequency at which to evaluate the spectral density.}

\item{nu}{Matern smoothness parameter.}
}
\value{
\code{matern32_kernel} returns \eqn{K(d) = \alpha^2 (1 + \sqrt3\, d/\rho)
\exp(-\sqrt3\, d/\rho)}, with the same shape as \code{D}.

\code{matern_spectral_density} returns the spectral density
\eqn{S(\omega)}.
}
\description{
\code{matern32_kernel} is the standard isotropic Matern-3/2 covariance
function, applied elementwise to a distance (matrix or vector).

\code{matern_spectral_density} is the closed-form spectral density of an
isotropic Matern-\eqn{\nu} covariance in 2 spatial dimensions, used as the
prior variance on each basis-function weight in the Hilbert Space Gaussian
Process (HSGP) approximation of Riutort-Mayol et al. (2020).

Neither function was defined anywhere in the original repository (they
were referenced by \code{build_hsgp_basis()} and \code{gp_node()} but
never implemented, so the code could not run as committed); these are
standard, well-established closed forms supplied when packaging.
}
